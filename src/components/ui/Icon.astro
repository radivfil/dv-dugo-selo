---
/**
 * Icon — jedini ulaz za ikone na stranici (Lucide set).
 * Prima ime ikone kao string (npr. "Leaf"), pa se ikone mogu zadavati iz konfiguracije i CMS-a.
 * Bez `label` ikona je dekorativna (aria-hidden); s `label` dobiva role="img".
 */
import { icons } from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
}

const { name, size = 24, class: className, strokeWidth = 1.75, label } = Astro.props;
const Component = (icons as Record<string, any>)[name];
if (!Component) throw new Error(`Icon: nepoznata Lucide ikona "${name}"`);
---

{
  label ? (
    <Component size={size} class={className} stroke-width={strokeWidth} role="img" aria-label={label} />
  ) : (
    <Component size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" />
  )
}
