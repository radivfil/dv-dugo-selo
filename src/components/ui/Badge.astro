---
/**
 * Badge — istaknuta oznaka statusa (npr. Eko vrtić). Ikona + naslov + kratko objašnjenje.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  text?: string;
  icon?: string;
  class?: string;
  [key: string]: unknown;
}

const { title, text, icon, class: className, ...rest } = Astro.props;
---

<p {...rest} class:list={['inline-flex items-center gap-3 rounded-full border border-accent bg-accent-soft py-1.5 pr-4 pl-1.5 text-sm', className]}>
  {
    icon && (
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent text-on-accent">
        <Icon name={icon} size={20} />
      </span>
    )
  }
  <span class="leading-snug">
    <strong class="font-heading font-semibold text-ink">{title}</strong>
    {
      text && (
        <>
          {' '}
          <span class="hidden text-muted sm:inline" aria-hidden="true">·{' '}</span>
          <span class="block text-muted sm:inline">{text}</span>
        </>
      )
    }
  </span>
</p>
