---
/**
 * PageHeader — zaglavlje podstranice: putanja (breadcrumb), nadnaslov, h1 i uvod.
 * Slot služi za dodatne gumbe ispod uvoda.
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: { label: string; href: string }[];
}

const { title, eyebrow, lead, crumbs = [] } = Astro.props;
---

<header class="border-b border-line bg-surface-2">
  <div class="container-site py-10 md:py-14">
    <nav aria-label="Putanja" class="mb-5 text-sm">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
        <li><a href="/" class="inline-flex min-h-8 items-center">Početna</a></li>
        {
          crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              <a href={c.href} class="inline-flex min-h-8 items-center">{c.label}</a>
            </li>
          ))
        }
        <li class="flex items-center gap-2">
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="font-semibold text-ink">{title}</span>
        </li>
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="max-w-[22ch]">{title}</h1>
    {lead && <p class="lead mt-4">{lead}</p>}
    <slot />
  </div>
</header>
