---
/** Upisi i ispisi: koraci upisa, CTA prema sustavu e-Upisi (bez vlastite aplikacije) i ispis iz vrtića. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';
import { formatDate } from '../lib/format';

const docs = (await getCollection('dokumenti', (d) => d.data.category === 'Upisi')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Upisi i ispisi" description={site.enrollment.intro}>
  <PageHeader title="Upisi i ispisi" eyebrow="Upis i ispis djeteta" lead={site.enrollment.intro}>
    <div class="mt-7 flex flex-col gap-3 min-[26rem]:flex-row min-[26rem]:flex-wrap">
      <a href={site.enrollment.url} class="btn btn-cta" target="_blank" rel="noopener">
        Otvori e-Upise
        <Icon name="ExternalLink" size={20} />
        <span class="visually-hidden">(otvara se u novom prozoru)</span>
      </a>
      <a href="#ispis" class="btn btn-outline">Ispis iz vrtića</a>
      <a href="#dokumenti-upisi" class="btn btn-outline">Natječaj i rezultati</a>
    </div>
  </PageHeader>

  <section class="section" aria-labelledby="koraci">
    <div class="container-site">
      <SectionHeading id="koraci" title="Četiri koraka do upisa" />
      <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          site.enrollment.steps.map((s, i) => (
            <li class="card relative p-6" data-reveal style={`--reveal-i:${i}`}>
              <span class="font-heading text-4xl font-bold text-brand-ink" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3">
                <span class="visually-hidden">Korak {i + 1}: </span>
                {s.title}
              </h3>
              <p class="mt-2 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-surface-2" aria-labelledby="prednost">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading id="prednost" title="Tko ima prednost" />
        <div class="prose-site" data-reveal>
          <p>{site.enrollment.priorityIntro}</p>
          <ul>
            {site.enrollment.priority.map((p) => <li>{p}</li>)}
          </ul>
          <p>Točna mjerila i bodovanje propisuje Pravilnik o upisu, koji je dostupan među dokumentima.</p>
        </div>
      </div>
      <div class="card self-start p-6 md:p-8" data-reveal style="--reveal-i:1">
        <h2 class="text-xl">Trebate pomoć s prijavom?</h2>
        <p class="mt-2 text-muted">Tajništvo pomaže roditeljima koji nemaju pristup sustavu e-Građani ili su zapeli s prijavom.</p>
        <ul class="mt-4 grid gap-2">
          <li>
            <a href={`tel:${site.contact.phoneHref}`} class="inline-flex min-h-11 items-center gap-2 font-semibold">
              <Icon name="Phone" size={20} />
              {site.contact.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="inline-flex min-h-11 items-center gap-2 font-semibold">
              <Icon name="Mail" size={20} />
              {site.contact.email}
            </a>
          </li>
          <li class="flex items-center gap-2 text-muted">
            <Icon name="Clock" size={20} />
            {site.hours[2].label}: {site.hours[2].value}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section id="ispis" class="section" aria-labelledby="ispis-naslov">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <SectionHeading id="ispis-naslov" eyebrow="Ispis iz vrtića" title="Ispis djeteta, bez dolaska u tajništvo" lead={site.withdrawal.intro} />
        <a href={site.withdrawal.href} class="btn btn-brand" data-reveal>
          Ispuni zahtjev za ispis
          <Icon name="ArrowRight" size={20} class="btn-arrow" />
        </a>
      </div>
      <ol class="grid gap-3" aria-label="Postupak ispisa">
        {
          site.withdrawal.steps.map((s, i) => (
            <li class="flex gap-4 rounded-[var(--radius-card)] border border-line bg-surface p-5" data-reveal style={`--reveal-i:${i}`}>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand font-heading font-semibold text-on-brand" aria-hidden="true">
                {i + 1}
              </span>
              <span>
                <span class="block font-heading text-lg font-semibold">{s.title}</span>
                <span class="block text-muted">{s.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-surface-2" aria-labelledby="dokumenti-upisi">
    <div class="container-site">
      <SectionHeading id="dokumenti-upisi" title="Natječaj i obavijesti" />
      <ul class="grid gap-3">
        {
          docs.map((d) => (
            <li>
              <a href={d.data.file} class="card interactive-card flex items-center gap-4 p-4 no-underline" target="_blank" rel="noopener">
                <Icon name="FileText" size={24} class="shrink-0 text-brand-ink" />
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold text-ink">{d.data.title}</span>
                  <span class="block text-sm text-muted">
                    PDF · {formatDate(d.data.date)}
                  </span>
                </span>
                <Icon name="Download" size={20} class="shrink-0 text-muted" />
                <span class="visually-hidden">(PDF, otvara se u novom prozoru)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
