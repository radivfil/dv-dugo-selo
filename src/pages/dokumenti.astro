---
/** Dokumenti i transparentnost: pretraživa tablica svih dokumenata iz CMS-a + informacije o pristupu informacijama. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import DocumentTable from '../components/sections/DocumentTable.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';

const documents = (await getCollection('dokumenti')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Dokumenti i transparentnost"
  description="Statut, pravilnici, financijski planovi i izvješća, javna nabava i odluke Upravnog vijeća Dječjeg vrtića Dugo Selo.">
  <PageHeader
    title="Dokumenti i transparentnost"
    eyebrow="Javnost rada"
    lead="Kao javna ustanova objavljujemo akte, financijske planove i izvješća, postupke javne nabave i odluke Upravnog vijeća. Dokumente pretražite po nazivu, kategoriji ili godini."
  />

  <section class="section" aria-label="Popis dokumenata">
    <div class="container-site">
      <DocumentTable documents={documents} categories={site.documentCategories} />

      <section class="mt-10 grid gap-4 rounded-[var(--radius-card)] border border-line bg-surface-2 p-6 md:grid-cols-[auto_1fr] md:p-8" aria-labelledby="pristup-info">
        <span class="grid h-12 w-12 place-items-center rounded-full bg-brand text-on-brand">
          <Icon name="Scale" size={24} />
        </span>
        <div>
          <h2 id="pristup-info" class="text-xl">Pravo na pristup informacijama</h2>
          <p class="mt-2 max-w-[70ch] text-muted">
            Zahtjev za pristup informacijama možete podnijeti službeniku za informiranje pisanim putem na adresu vrtića ili e-poštom na{' '}
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>. Odgovor dobivate u zakonskom roku od 15 dana.
          </p>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
