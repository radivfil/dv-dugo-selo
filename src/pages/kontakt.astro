---
/** Kontakt: adresa, telefon, e-pošta, radno vrijeme, karta (OpenStreetMap) i kontakt obrazac (tip "kontakt"). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import FormShell from '../components/forms/FormShell.astro';
import FormField from '../components/forms/FormField.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';

const c = site.contact;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(c.map.bbox)}&layer=mapnik&marker=${encodeURIComponent(c.map.marker)}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${c.map.marker.split(',')[0]}&mlon=${c.map.marker.split(',')[1]}#map=17/${c.map.marker.replace(',', '/')}`;
---

<BaseLayout title="Kontakt" description={`Adresa, telefon, e-pošta i radno vrijeme: ${site.name}, ${c.address}, ${c.postalCity}.`}>
  <PageHeader title="Kontakt" eyebrow="Tu smo za vas" lead="Za pitanja o upisima, boravku djeteta ili plaćanju javite se tajništvu. Pitanja o skupini najbrže rješava izravan razgovor s odgojiteljima." />

  <section class="section" aria-label="Podaci za kontakt">
    <div class="container-site grid gap-6 lg:grid-cols-[1fr_1.4fr]">
      <div class="grid content-start gap-4">
        <div class="on-brand rounded-[var(--radius-card)] bg-brand p-6 text-on-brand md:p-8">
          <h2 class="text-xl text-on-brand">{site.legalName}</h2>
          <address class="mt-4 grid gap-3 not-italic">
            <p class="flex gap-3">
              <Icon name="MapPin" size={22} class="mt-0.5 shrink-0 text-accent" />
              <span>{c.address}<br />{c.postalCity}</span>
            </p>
            <a href={`tel:${c.phoneHref}`} class="flex min-h-11 items-center gap-3 text-lg font-semibold text-on-brand">
              <Icon name="Phone" size={22} class="shrink-0 text-accent" />
              {c.phone}
            </a>
            <a href={`mailto:${c.email}`} class="flex min-h-11 items-center gap-3 text-lg font-semibold break-all text-on-brand">
              <Icon name="Mail" size={22} class="shrink-0 text-accent" />
              {c.email}
            </a>
          </address>
        </div>

        <div class="card p-6">
          <h2 class="flex items-center gap-2 text-lg"><Icon name="Clock" size={20} class="text-brand-ink" />Radno vrijeme</h2>
          <dl class="mt-3 grid gap-3">
            {
              site.hours.map((h) => (
                <div class="flex flex-wrap justify-between gap-x-4 border-b border-line pb-2 last:border-0 last:pb-0">
                  <dt class="font-semibold">{h.label}</dt>
                  <dd class="text-muted">{h.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="card p-6">
          <h2 class="text-lg">Područni objekti</h2>
          <ul class="mt-3 grid gap-3">
            {
              site.locations.slice(1).map((l) => (
                <li>
                  <span class="block font-semibold">{l.name}</span>
                  <span class="block text-muted">{l.address}</span>
                  <a href={`tel:${l.phone.replace(/\s/g, '')}`} class="inline-flex min-h-11 items-center">{l.phone}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="grid content-start gap-3">
        <div class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface-2">
          <iframe
            src={mapSrc}
            title={`Karta: ${site.name}, ${c.address}`}
            loading="lazy"
            referrerpolicy="no-referrer"
            class="block aspect-[4/3] w-full border-0 lg:aspect-auto lg:h-[34rem]"></iframe>
        </div>
        <a href={mapLink} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 self-start font-semibold">
          Otvori veću kartu i upute za dolazak
          <Icon name="ExternalLink" size={18} />
          <span class="visually-hidden">(otvara se u novom prozoru)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-surface-2" aria-labelledby="obrazac-naslov">
    <div class="container-site grid gap-8 lg:grid-cols-[20rem_1fr]">
      <div>
        <p class="eyebrow mb-2">Kontakt obrazac</p>
        <h2 id="obrazac-naslov">Pošaljite nam poruku</h2>
        <p class="mt-3 text-muted">Odgovaramo radnim danom, najkasnije u roku od tri dana. Za prijavu izostanka koristite poseban obrazac.</p>
        <a href="/roditelji/prijava-izostanka" class="btn btn-outline mt-5">Prijava izostanka</a>
      </div>
      <FormShell
        id="obrazac"
        type="kontakt"
        submitLabel="Pošalji poruku"
        successTitle="Poruka je poslana"
        successText="Hvala! Tajništvo će vam odgovoriti na navedenu e-poštu, najkasnije u roku od tri radna dana.">
        <FormField name="parent_name" label="Ime i prezime" map="parent_name" required autocomplete="name" />
        <FormField name="parent_contact" label="E-pošta" type="email" map="parent_contact" required autocomplete="email" />
        <FormField name="subject" label="Tema" type="select" options={['Upisi', 'Plaćanje i računi', 'Boravak djeteta', 'Zapošljavanje', 'Ostalo']} required />
        <FormField name="child_name" label="Ime djeteta" map="child_name" autocomplete="off" hint="Ako se upit odnosi na dijete u vrtiću." />
        <FormField name="message" label="Poruka" type="textarea" required class="sm:col-span-2" maxlength={2000} />
      </FormShell>
    </div>
  </section>
</BaseLayout>
